---
import '@/styles/globals.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Ruinners — juego de mesa estratégico de conquista espacial" } = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta name="twitter:card" content="summary_large_image" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<slot />
		<script>
			function initLightbox() {
				const triggers = document.querySelectorAll<HTMLElement>('[data-lightbox]');
				if (triggers.length === 0) return;

				let overlay: HTMLElement | null = null;
				let img: HTMLImageElement | null = null;

				function closeLightbox() {
					if (!overlay) return;
					overlay.classList.remove('lightbox-open');
					overlay.classList.add('lightbox-closing');
					setTimeout(() => {
						overlay?.remove();
						overlay = null;
						img = null;
						document.body.style.overflow = '';
					}, 250);
				}

				function openLightbox(src: string, alt: string) {
					overlay = document.createElement('div');
					overlay.className = 'fixed inset-0 z-[100] flex items-center justify-center bg-background/90 backdrop-blur-sm lightbox-closing';
					overlay.style.opacity = '0';
					overlay.style.transition = 'opacity 250ms ease-out';

					img = document.createElement('img');
					img.src = src;
					img.alt = alt;
					img.className = 'max-h-[85vh] max-w-[90vw] rounded-lg border border-primary/30 object-contain shadow-2xl';
					img.style.transform = 'scale(0.95)';
					img.style.transition = 'transform 250ms ease-out';

					const closeBtn = document.createElement('button');
					closeBtn.type = 'button';
					closeBtn.className = 'absolute top-6 right-6 flex h-12 w-12 items-center justify-center rounded-full border border-border bg-card/80 text-foreground transition-all hover:border-primary hover:bg-card hover:scale-110';
					closeBtn.setAttribute('aria-label', 'Cerrar');
					closeBtn.innerHTML = '<svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>';

					overlay.appendChild(img);
					overlay.appendChild(closeBtn);
					document.body.appendChild(overlay);
					document.body.style.overflow = 'hidden';

					requestAnimationFrame(() => {
						overlay?.classList.remove('lightbox-closing');
						overlay?.classList.add('lightbox-open');
						if (overlay) overlay.style.opacity = '1';
						if (img) img.style.transform = 'scale(1)';
					});

					overlay.addEventListener('click', (e) => {
						if (e.target === overlay || e.target === closeBtn) closeLightbox();
					});
				}

				triggers.forEach((trigger) => {
					if (trigger.dataset.lightboxInit) return;
					trigger.dataset.lightboxInit = '1';
					trigger.addEventListener('click', (e) => {
						e.preventDefault();
						const src = trigger.dataset.lightbox || '';
						const alt = trigger.dataset.lightboxAlt || '';
						openLightbox(src, alt);
					});
				});

				document.addEventListener('keydown', (e) => {
					if (e.key === 'Escape' && overlay) closeLightbox();
				});
			}

			initLightbox();
			document.addEventListener('astro:page-load', initLightbox);
		</script>
	</body>
</html>
