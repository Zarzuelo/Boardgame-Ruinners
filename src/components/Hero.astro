---
import { getLandingData } from '@/lib/content';

const data = await getLandingData();
const hero = data.hero;
---

<section id="top" class="relative min-h-screen overflow-hidden bg-background">
  {hero.backgroundImage ? (
    <div class="absolute inset-0">
      <img src={hero.backgroundImage} alt={hero.title} class="h-full w-full object-cover" />
    </div>
  ) : (
    <>
      <div class="absolute inset-0 bg-grid opacity-30"></div>
      <div class="absolute top-1/4 right-20 h-64 w-64 animate-float-slow rounded-full bg-primary/10 blur-3xl"></div>
      <div class="absolute bottom-1/4 left-10 h-72 w-72 animate-float rounded-full bg-accent/10 blur-3xl"></div>
    </>
  )}

  <!-- Gradient overlays -->
  <div class="absolute inset-0 bg-gradient-to-b from-background/60 via-background/80 to-background"></div>
  <div class="absolute inset-0 bg-gradient-to-r from-background via-background/40 to-transparent"></div>

  <div class="relative mx-auto flex min-h-screen max-w-7xl flex-col justify-center px-6 pt-28 pb-16 lg:px-8">
    <!-- Badge -->
    <div class="animate-fade-in-up mb-6 inline-flex items-center gap-3 clip-corner-sm border border-primary/30 bg-primary/5 px-4 py-2 self-start">
      <span class="h-2 w-2 animate-pulse rounded-full bg-primary"></span>
      <span class="text-xs font-medium uppercase tracking-widest text-primary">
        {hero.badge}
      </span>
    </div>

    <!-- Title + cover image (desktop: side by side) -->
    <div class="flex items-center gap-4 sm:gap-6">
      <h1 class="animate-fade-in-up font-display text-5xl font-black tracking-tighter text-foreground sm:text-7xl lg:text-8xl text-glow" style="animation-delay: 0.1s; opacity: 0;">
        {hero.title}
      </h1>

      {hero.coverImage && (
        <button
          type="button"
          data-lightbox={hero.coverImage}
          data-lightbox-alt={hero.title}
          class="animate-fade-in-up group/img relative hidden shrink-0 overflow-hidden clip-corner border border-primary/30 shadow-xl transition-all duration-500 hover:border-primary/60 hover:shadow-[0_0_40px_hsl(158_64%_42%_/_0.3)] sm:block"
          style="animation-delay: 0.15s; opacity: 0;"
          aria-label="Ampliar imagen de portada"
        >
          <img
            src={hero.coverImage}
            alt={hero.title}
            class="h-28 w-28 object-cover transition-transform duration-700 group-hover/img:scale-105 lg:h-36 lg:w-36"
          />
          <span class="pointer-events-none absolute inset-0 flex items-center justify-center bg-background/0 opacity-0 transition-all duration-300 group-hover/img:bg-background/30 group-hover/img:opacity-100">
            <svg class="h-5 w-5 text-foreground" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v6M7 10h6" />
            </svg>
          </span>
        </button>
      )}
    </div>

    <!-- Subtitle -->
    <p class="animate-fade-in-up mt-4 font-display text-xl font-medium tracking-wide text-accent sm:text-2xl text-glow-accent" style="animation-delay: 0.2s; opacity: 0;">
      {hero.subtitle}
    </p>

    <!-- Cover image (mobile: centered, between subtitle and description) -->
    {hero.coverImage && (
      <div class="animate-fade-in-up mt-6 flex justify-center sm:hidden" style="animation-delay: 0.25s; opacity: 0;">
        <button
          type="button"
          data-lightbox={hero.coverImage}
          data-lightbox-alt={hero.title}
          class="group/img relative block overflow-hidden clip-corner border border-primary/30 shadow-xl transition-all duration-500 hover:border-primary/60"
          aria-label="Ampliar imagen de portada"
        >
          <img
            src={hero.coverImage}
            alt={hero.title}
            class="h-44 w-44 object-cover transition-transform duration-700 group-hover/img:scale-105"
          />
          <span class="pointer-events-none absolute inset-0 flex items-center justify-center bg-background/0 opacity-0 transition-all duration-300 group-hover/img:bg-background/30 group-hover/img:opacity-100">
            <svg class="h-6 w-6 text-foreground" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v6M7 10h6" />
            </svg>
          </span>
        </button>
      </div>
    )}

    <!-- Description -->
    <p class="animate-fade-in-up mt-6 max-w-2xl text-base leading-relaxed text-muted-foreground sm:text-lg" style="animation-delay: 0.3s; opacity: 0;">
      {hero.description}
    </p>

    <!-- CTAs -->
    <div id="hero-cta" class="animate-fade-in-up mt-10 flex flex-col gap-4 sm:flex-row sm:flex-wrap" style="animation-delay: 0.4s; opacity: 0;">
      <a
        href={hero.ludoUrl}
        class="group relative inline-flex items-center justify-center gap-2 clip-corner border border-primary bg-primary px-8 py-4 font-display text-sm font-bold uppercase tracking-widest text-primary-foreground transition-all duration-300 hover:scale-[1.02] hover:shadow-[0_0_30px_hsl(158_64%_42%_/_0.4)]"
      >
        <span>{hero.ludoButtonText}</span>
        <svg class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>

      <a
        href={hero.salesUrl}
        class="group inline-flex items-center justify-center gap-2 clip-corner border border-accent/50 bg-accent/10 px-8 py-4 font-display text-sm font-bold uppercase tracking-widest text-accent transition-all duration-300 hover:bg-accent hover:text-accent-foreground hover:border-accent"
      >
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
        </svg>
        <span>{hero.salesButtonText}</span>
      </a>

      <a
        href={hero.videoUrl}
        class="group inline-flex items-center justify-center gap-2 clip-corner border border-border bg-secondary/50 px-8 py-4 font-display text-sm font-bold uppercase tracking-widest text-foreground transition-all duration-300 hover:border-primary/50 hover:bg-secondary"
      >
        <svg class="h-5 w-5 text-primary transition-transform duration-300 group-hover:scale-110" fill="currentColor" viewBox="0 0 24 24">
          <path d="M8 5v14l11-7z" />
        </svg>
        <span>{hero.videoButtonText}</span>
      </a>

      <a
        href="mailto:ruinners@hemosjugaomal.com?subject=Inter%C3%A9s%20en%20el%20prototipo%20Ruinners&body=Hola%2C%20me%20interesa%20el%20prototipo%20de%20Ruinners%20y%20quiero%20enterarme%20de%20las%20novedades."
        class="group relative inline-flex items-center justify-center gap-2 clip-corner border border-accent/50 bg-accent/10 px-8 py-4 font-display text-sm font-bold uppercase tracking-widest text-accent transition-all duration-300 hover:bg-accent hover:text-accent-foreground hover:border-accent hover:scale-[1.02]"
      >
        <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
        </svg>
        <span>Avísame del proto</span>
      </a>
    </div>
  </div>

</section>
