---
import { getLandingData } from '@/lib/content';

const data = await getLandingData();
const components = data.components;

const iconMap: Record<string, string> = {
  Map: 'M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7',
  Dices: 'M5 3h4a2 2 0 012 2v4a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2zm10 8h4a2 2 0 012 2v4a2 2 0 01-2 2h-4a2 2 0 01-2-2v-4a2 2 0 012-2zM7 7m0 .01M17 17m0 .01M12 12h.01',
  Users: 'M17 20h5v-2a4 4 0 00-3-3.87M9 20H4v-2a4 4 0 013-3.87m6-4a4 4 0 11-8 0 4 4 0 018 0zm6-3a3 3 0 11-6 0 3 3 0 016 0z',
  Target: 'M12 2a10 10 0 100 20 10 10 0 000-20zm0 6a4 4 0 100 8 4 4 0 000-8zm0 2a2 2 0 110 4 2 2 0 010-4z',
  Zap: 'M13 2L3 14h9l-1 8 10-12h-9l1-8z',
  Shield: 'M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z',
  Swords: 'M14.5 3.5L21 10l-6.5 6.5L8 10l6.5-6.5zM3 21l6-6m6 0l3-3',
  Skull: 'M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zM8 14a2 2 0 110-4 2 2 0 010 4zm8 0a2 2 0 110-4 2 2 0 010 4z',
  Flame: 'M12 2C12 2 7 7 7 12c0 3 2 5 5 5s5-2 5-5c0-5-5-10-5-10zM12 17c-1.5 0-3-1-3-3 0-2 3-5 3-5s3 3 3 5c0 2-1.5 3-3 3z',
  Crown: 'M5 16L3 8l5.5 5L12 5l3.5 8L21 8l-2 8H5zm0 3h14v2H5v-2z',
};

function getIconPath(icon: string) {
  return iconMap[icon] || iconMap.Map;
}
---

<section id="componentes" class="relative overflow-hidden bg-secondary/30 py-24 lg:py-32">
  <div class="absolute inset-0 bg-grid opacity-10"></div>
  <div class="absolute bottom-0 left-0 h-1/2 w-full bg-gradient-to-t from-background to-transparent"></div>

  <div class="relative mx-auto max-w-7xl px-6 lg:px-8">
    <div class="mx-auto max-w-3xl text-center">
      <div class="mb-4 inline-flex items-center gap-2 clip-corner-sm border border-accent/30 bg-accent/5 px-4 py-1.5">
        <span class="text-xs font-semibold uppercase tracking-widest text-accent">
          {components.badge}
        </span>
      </div>
      <h2 class="font-display text-4xl font-bold tracking-tight text-foreground sm:text-5xl lg:text-6xl">
        {components.title}
      </h2>
      <p class="mt-6 text-base leading-relaxed text-muted-foreground sm:text-lg">
        {components.description}
      </p>
    </div>

    <div class="mt-16 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:gap-8">
      {components.features.map((feature, index) => (
        <div
          class="group/item flex flex-col gap-5 clip-corner border border-border bg-card/50 p-6 transition-all duration-300 hover:border-primary/40 hover:bg-card lg:p-8"
        >
          <div class="flex items-start gap-5">
            <div class="flex h-12 w-12 shrink-0 items-center justify-center overflow-hidden clip-corner-sm border border-primary/30 bg-primary/10 transition-all duration-300 group-hover/item:border-primary group-hover/item:bg-primary/20">
              <svg
                class="h-6 w-6 text-primary"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                stroke-width="1.5"
              >
                <path stroke-linecap="round" stroke-linejoin="round" d={getIconPath(feature.icon)} />
              </svg>
            </div>
            <div class="flex-1">
              <h3 class="font-display text-lg font-bold tracking-tight text-foreground">
                {feature.title}
              </h3>
              <p class="mt-2 text-sm leading-relaxed text-muted-foreground">
                {feature.description}
              </p>
            </div>
          </div>

          {feature.image && (
            <button
              type="button"
              data-lightbox={feature.image}
              data-lightbox-alt={feature.title}
              class="group/img relative mt-2 overflow-hidden clip-corner-sm border border-border transition-all duration-300 hover:border-primary/40"
              aria-label={`Ampliar imagen de ${feature.title}`}
            >
              <img
                src={feature.image}
                alt={feature.title}
                class="aspect-[4/3] w-full object-cover transition-transform duration-500 group-hover/img:scale-105"
                loading="lazy"
              />
              <span class="pointer-events-none absolute inset-0 flex items-center justify-center bg-background/0 opacity-0 transition-all duration-300 group-hover/img:bg-background/40 group-hover/img:opacity-100">
                <span class="flex items-center gap-2 rounded-full bg-background/90 px-4 py-2 text-xs font-semibold uppercase tracking-widest text-foreground shadow-lg">
                  <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v6M7 10h6" />
                  </svg>
                  Ampliar
                </span>
              </span>
            </button>
          )}
        </div>
      ))}
    </div>
  </div>
</section>
